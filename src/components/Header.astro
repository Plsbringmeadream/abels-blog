---
import { SITE_TITLE } from '../consts';
import SearchModal from './SearchModal.astro';
const currentPath = Astro.url.pathname;
---

<header class="site-header" transition:name="site-header" transition:persist>
  <div class="site-header-inner">
    <a href="/" class="site-title">{SITE_TITLE}</a>
    <nav class="site-nav">
      <a href="/blog" class:list={["nav-link", { active: currentPath.startsWith('/blog') }]}>Posts</a>
      <a href="/tags" class:list={["nav-link", { active: currentPath.startsWith('/tags') }]}>Tags</a>
      <a href="/about" class:list={["nav-link", { active: currentPath === '/about' }]}>About</a>
      <button class="icon-btn" aria-label="Search" onclick="window._toggleSearch()">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </button>
      <button class="icon-btn" aria-label="Toggle dark mode" id="theme-toggle">
        <svg id="moon-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg id="sun-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      </button>
    </nav>
  </div>
</header>

<SearchModal />

<!-- Sac decorative elements: rail lines + corner crosses -->
<div class="rail" aria-hidden="true"><i></i><i></i><i></i></div>
<span class="cross cross--tr" aria-hidden="true"></span>
<span class="cross cross--bl" aria-hidden="true"></span>
<span class="cross cross--br" aria-hidden="true"></span>

<script>
  let _themeInited = false;
  function initTheme() {
    if (_themeInited) return;
    const themeToggle = document.getElementById('theme-toggle');
    const moonIcon = document.getElementById('moon-icon');
    const sunIcon = document.getElementById('sun-icon');
    const html = document.documentElement;

    if (localStorage.getItem('theme') === 'dark') {
      html.classList.add('dark');
      if (moonIcon) moonIcon.style.display = 'none';
      if (sunIcon) sunIcon.style.display = 'inline';
    }

    themeToggle?.addEventListener('click', () => {
      html.classList.toggle('dark');
      const isDark = html.classList.contains('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      if (moonIcon) moonIcon.style.display = isDark ? 'none' : 'inline';
      if (sunIcon) sunIcon.style.display = isDark ? 'inline' : 'none';
    });
    _themeInited = true;
  }
  document.addEventListener('astro:page-load', initTheme);
  initTheme();
</script>

<style>
  .site-header {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    height: var(--nav-h);
    display: flex; align-items: center;
    padding: 0 var(--pad-x);
    border-bottom: 1px solid var(--line);
    background: rgba(244,239,230,.82);
    backdrop-filter: blur(8px);
  }
  :global(.dark) .site-header {
    background: rgba(15,18,25,.85);
    border-bottom-color: #333;
    backdrop-filter: blur(12px);
  }
  .site-header-inner {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .site-title {
    font-family: var(--serif);
    font-size: 22px; font-weight: 600; letter-spacing: -.02em;
    color: var(--ink);
    text-decoration: none;
  }
  :global(.dark) .site-title { color: #e8e8e8; }
  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }
  .nav-link {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: .08em;
    color: var(--nav-fg);
    text-decoration: none;
    transition: color .25s;
  }
  .nav-link:hover { color: var(--nav-hover-fg); }
  .nav-link.active {
    color: var(--nav-active-fg);
  }
  .nav-link.active::after {
    content: ""; display: block; height: 1px; background: var(--accent); margin-top: 3px;
  }
  :global(.dark) .nav-link { color: #aaa; }
  :global(.dark) .nav-link:hover, :global(.dark) .nav-link.active { color: #e8e8e8; }
  .icon-btn {
    background: none; border: none; cursor: pointer;
    padding: 5px;
    color: var(--ink-soft);
    display: flex; align-items: center;
    border-radius: 4px;
    transition: color 0.2s;
  }
  .icon-btn:hover { color: var(--accent); }
  :global(.dark) .icon-btn { color: #aaa; }
  :global(.dark) .icon-btn:hover { color: #e8e8e8; }

  /* Sac Rail + Cross */
  .rail { position: fixed; top: 0; bottom: 0; left: var(--rail-x); z-index: 3; pointer-events: none; }
  .rail i { position: absolute; top: calc(var(--nav-h) + 40px); bottom: 48px; width: 1px; background: var(--line); opacity: .7; }
  .rail i:nth-child(1) { left: 0; }
  .rail i:nth-child(2) { left: 7px; }
  .rail i:nth-child(3) { left: 14px; }

  .cross { position: fixed; z-index: 3; width: 18px; height: 18px; pointer-events: none; opacity: .5; }
  .cross::before, .cross::after { content: ""; position: absolute; background: var(--line); }
  .cross::before { left: 8px; top: 0; width: 1px; height: 18px; }
  .cross::after { top: 8px; left: 0; height: 1px; width: 18px; }
  .cross--tr { top: calc(var(--nav-h) + 22px); right: 38px; }
  .cross--bl { bottom: 34px; left: 34px; }
  .cross--br { bottom: 34px; right: 38px; }

  @media (max-width: 600px) {
    .site-header { height: 72px; padding: 0 var(--pad-x); }
    .rail, .cross { display: none; }
    .site-title { font-size: 18px; }
    .site-nav { gap: 0.8rem; }
    .nav-link { font-size: 0.75rem; letter-spacing: .04em; }
  }
</style>
