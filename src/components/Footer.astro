---
const year = new Date().getFullYear();
---
<footer>
  <nav class="footer-nav">
    <a href="/blog">Posts</a>
    <a href="/tags">Tags</a>
    <a href="/about">About</a>
    <a href="/rss.xml">RSS</a>
  </nav>
  <p>&copy; {year} Abel &middot; Made with <a href="https://astro.build" target="_blank">Astro</a></p>
</footer>

<style>
  footer {
    text-align: center;
    padding: 2.5rem 1rem 2rem;
    margin-top: 3rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.85rem;
  }
  .footer-nav {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 1rem;
  }
  .footer-nav a {
    color: var(--nav-fg);
    text-decoration: none;
    font-size: 0.85rem;
    transition: color .2s;
  }
  .footer-nav a:hover { color: var(--nav-hover-fg); }
  footer p { margin: 0; }
  footer p a {
    color: var(--link-fg);
    text-decoration: none;
    transition: color .2s;
  }
  footer p a:hover { color: var(--link-hover-fg); text-decoration: underline; }
</style>
