---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import FormattedDate from '../../components/FormattedDate.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const tagSet = new Set<string>();
  for (const post of posts) {
    for (const tag of post.data.tags ?? []) {
      tagSet.add(tag);
    }
  }
  return [...tagSet].map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter((p) => (p.data.tags ?? []).includes(tag))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<!doctype html>
<html lang="zh">
  <head>
    <BaseHead title={`#${tag}`} description={`标签 #${tag} 下的文章`} />
    <style>
      .back { display: inline-block; margin-bottom: 1.5rem; color: var(--accent); text-decoration: none; font-size: 0.95rem; }
      .back:hover { text-decoration: underline; }
      h1 { margin-bottom: 0.5rem; }
      .count { color: var(--muted); margin-bottom: 1.5rem; }
      .post-item { padding: 1.2rem 0; border-bottom: 1px solid var(--line); }
      .post-item:last-child { border-bottom: none; }
      .post-item a { font-size: 1.1rem; font-weight: 600; text-decoration: none; color: var(--accent); }
      .post-item a:hover { text-decoration: underline; }
      .post-meta { font-size: 0.85rem; color: var(--muted); margin: 0.3rem 0 0.5rem; }
      .post-item p { color: var(--ink-soft); margin: 0; font-size: 0.95rem; }
    </style>
  </head>
  <body>
    <Header />
    <main class="blog-main">
      <a class="back" href="/tags/">← 所有标签</a>
      <h1>#{tag}</h1>
      <p class="count">{posts.length} 篇文章</p>
      {posts.map((post) => (
        <div class="post-item">
          <a href={`/blog/${post.id}/`}>{post.data.title}</a>
          <div class="post-meta"><FormattedDate date={post.data.pubDate} /></div>
          <p>{post.data.description}</p>
        </div>
      ))}
    </main>
    <Footer />
  </body>
</html>
