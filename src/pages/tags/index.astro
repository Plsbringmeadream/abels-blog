---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

const posts = await getCollection('blog');
const tagMap = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags ?? []) {
    tagMap.set(tag, (tagMap.get(tag) ?? 0) + 1);
  }
}
const tags = [...tagMap.entries()].sort((a, b) => b[1] - a[1]);
---

<!doctype html>
<html lang="zh">
  <head>
    <BaseHead title="标签 | Tags" description="按标签浏览文章 / Browse posts by tag" />
    <style>
      h1 { margin-bottom: 0.5rem; }
      p.sub { color: var(--muted); margin-bottom: 1rem; }
      .tag-cloud { display: flex; flex-wrap: wrap; gap: 0.75rem; padding: 2rem 0; }
      .tag-link {
        display: inline-flex; align-items: center; gap: 0.4rem;
        padding: 0.4rem 1rem;
        border: var(--tag-border);
        border-radius: var(--tag-radius);
        text-decoration: none;
        color: var(--tag-fg);
        font-size: 0.95rem;
        transition: all 0.2s;
      }
      .tag-link:hover { border-color: var(--tag-hover-border); color: var(--tag-hover-fg); background: var(--tag-hover-bg); }
      .tag-count { font-size: 0.8rem; color: var(--muted); }
    </style>
  </head>
  <body>
    <Header />
    <main class="blog-main">
      <h1>标签 / Tags</h1>
      <p class="sub">共 {tags.length} 个标签</p>
      <div class="tag-cloud">
        {tags.map(([tag, count]) => (
          <a href={`/tags/${tag}/`} class="tag-link">
            #{tag}
            <span class="tag-count">{count}</span>
          </a>
        ))}
      </div>
    </main>
    <Footer />
  </body>
</html>
