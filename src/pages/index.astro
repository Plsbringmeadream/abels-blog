---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const totalPosts = allPosts.length;
const posts = allPosts.slice(0, 8);
const latestDate = posts.length > 0
  ? posts[0].data.pubDate.toLocaleDateString('en-US', { month: 'short', day: '2-digit' })
  : '—';

const posts3dData = await Promise.all(posts.map(async (post) => {
  let cover = null;
  if (post.data.heroImage) {
    const img = await getImage({ src: post.data.heroImage, width: 720, format: 'webp' });
    cover = img.src;
  }
  return {
    title: post.data.title,
    url: `/blog/${post.id}/`,
    date: post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }),
    tags: post.data.tags || [],
    cover,
  };
}));

const listPosts = posts.slice(0, 5);

// TOPICS side card: top tags by usage, so links always point to real tag pages.
const tagCount = new Map<string, number>();
for (const p of allPosts) {
  for (const t of p.data.tags ?? []) tagCount.set(t, (tagCount.get(t) ?? 0) + 1);
}
const topTags = [...tagCount.entries()].sort((a, b) => b[1] - a[1]).slice(0, 7).map(([t]) => t);

// BUILD section: real "building in public" projects, linked to their write-ups.
// Curated by slug so titles stay in sync with the content collection.
const buildProjectMeta: Record<string, string> = {
  '1688-auto-quote': 'shipping',
  'abelsourcing-website-admin': 'live',
  'ai-pulse-dashboard': 'building',
};
const buildProjects = Object.keys(buildProjectMeta)
  .map((slug) => {
    const post = allPosts.find((p) => p.id === slug);
    return post ? { title: post.data.title, url: `/blog/${post.id}/`, status: buildProjectMeta[slug] } : null;
  })
  .filter((p): p is { title: string; url: string; status: string } => p !== null);

// Build stats for the middle column
const buildStats = [
  { label: 'projects', value: String(buildProjects.length) },
  { label: 'posts', value: String(totalPosts) },
  { label: 'since', value: '2026' },
];

const techStack = ['Astro', 'Vercel', 'GSAP', 'Three.js', 'Python', 'Playwright', 'n8n', 'Claude API', 'Next.js'];
---

<!doctype html>
<html lang="zh">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />

    <!-- ───── SVG defs: 纸纹 + 双色调滤镜 ───── -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <filter id="duotone" color-interpolation-filters="sRGB">
          <feColorMatrix type="matrix" values="0.33 0.33 0.33 0 0 0.33 0.33 0.33 0 0 0.33 0.33 0.33 0 0 0 0 0 1 0"/>
          <feComponentTransfer color-interpolation-filters="sRGB">
            <feFuncR type="table" tableValues="0.102 0.941"/>
            <feFuncG type="table" tableValues="0.090 0.396"/>
            <feFuncB type="table" tableValues="0.078 0.180"/>
          </feComponentTransfer>
        </filter>
        <filter id="duotone-invert" color-interpolation-filters="sRGB">
          <feColorMatrix type="matrix" values="0.33 0.33 0.33 0 0 0.33 0.33 0.33 0 0 0.33 0.33 0.33 0 0 0 0 0 1 0"/>
          <feComponentTransfer color-interpolation-filters="sRGB">
            <feFuncR type="table" tableValues="0.941 0.102"/>
            <feFuncG type="table" tableValues="0.396 0.090"/>
            <feFuncB type="table" tableValues="0.180 0.078"/>
          </feComponentTransfer>
        </filter>
      </defs>
    </svg>

    <main>
      <!-- ═══════════ HERO ═══════════ -->
      <section class="hero" id="hero">
        <div class="hero__left">
          <h1 class="hero__wordmark" data-reveal>Abel's Blog</h1>
          <div class="hero__lower">
            <p class="hero__kicker" data-reveal><span class="dot"></span> Writing about life, things I love</p>
            <p class="hero__slogan" data-reveal>
              记录生活，分享热爱。<br />
              折腾 AI 工具 / 键帽爱好者 / 自动化探索者
            </p>
            <div class="hero__cta" data-reveal>
              <a href="/blog" class="btn btn--ghost">阅读文章 <span class="arr">→</span></a>
              <a href="/about" class="btn btn--link">关于我 <span class="arr">→</span></a>
            </div>
          </div>
        </div>
        <div class="hero__right">
          <figure class="portrait" data-portrait>
            <span class="portrait__media">
              <img src="/assets/avatar-cutout.png" alt="Abel 头像" class="portrait__img" />
            </span>
            <span class="portrait__cross portrait__cross--tl"></span>
            <span class="portrait__cross portrait__cross--br"></span>
          </figure>
        </div>

        <div class="hero__mascots" aria-hidden="true">
          <img class="hero__mascot hero__mascot--girl" src="/assets/35491fc88451e9abba7fe1113310921d.gif" alt="" />
          <img class="hero__mascot hero__mascot--kbd" src="/assets/keyboard.png" alt="" />
          <img class="hero__mascot hero__mascot--boy" src="/assets/a8287cfd9ec937ed9b14f20d3872fe02.gif" alt="" />
        </div>

        <!-- Pac-Man chases the cursor within the hero (driven by /js/pacman.js) -->
        <div class="pac-orbit" aria-hidden="true">
          <span class="pac-sprite pac-man">
            <svg viewBox="-20 -20 40 40"><path d="M0,0 L15.96,-1.12 A16,16 0 1 1 15.96,1.12 Z"></path></svg>
          </span>
          <span class="pac-sprite pac-ghost pac-ghost--1">
            <svg viewBox="0 0 32 35">
              <path class="gbody" d="M1,17 a15,15 0 0 1 30,0 V29 l-5,5 l-5,-5 l-5,5 l-5,-5 l-5,5 l-5,-5 Z"></path>
              <circle cx="11" cy="15" r="4.3" fill="#fff"></circle><circle cx="21" cy="15" r="4.3" fill="#fff"></circle>
              <circle cx="12.6" cy="15" r="2.1" fill="#3b5bdb"></circle><circle cx="22.6" cy="15" r="2.1" fill="#3b5bdb"></circle>
            </svg>
          </span>
          <span class="pac-sprite pac-ghost pac-ghost--2">
            <svg viewBox="0 0 32 35">
              <path class="gbody" d="M1,17 a15,15 0 0 1 30,0 V29 l-5,5 l-5,-5 l-5,5 l-5,-5 l-5,5 l-5,-5 Z"></path>
              <circle cx="11" cy="15" r="4.3" fill="#fff"></circle><circle cx="21" cy="15" r="4.3" fill="#fff"></circle>
              <circle cx="12.6" cy="15" r="2.1" fill="#3b5bdb"></circle><circle cx="22.6" cy="15" r="2.1" fill="#3b5bdb"></circle>
            </svg>
          </span>
          <span class="pac-sprite pac-ghost pac-ghost--3">
            <svg viewBox="0 0 32 35">
              <path class="gbody" d="M1,17 a15,15 0 0 1 30,0 V29 l-5,5 l-5,-5 l-5,5 l-5,-5 l-5,5 l-5,-5 Z"></path>
              <circle cx="11" cy="15" r="4.3" fill="#fff"></circle><circle cx="21" cy="15" r="4.3" fill="#fff"></circle>
              <circle cx="12.6" cy="15" r="2.1" fill="#3b5bdb"></circle><circle cx="22.6" cy="15" r="2.1" fill="#3b5bdb"></circle>
            </svg>
          </span>
        </div>
      </section>

      <!-- ═══════════ BLOG POSTS ═══════════ -->
      <section class="blog-section" id="writing">
        <div class="blog-section__inner">
          <h2 class="blog-section__title" data-reveal>最新文章</h2>
        </div>

        <div class="posts3d__area">
          <!-- Left: READING LOG -->
          <aside class="side-card side-card--log">
            <div class="side-card__head">READING LOG</div>
            <div class="side-card__body">
              <div class="log-line"><span class="log-k">posts</span> <span class="log-op">:</span> <span class="log-v">{totalPosts}</span></div>
              <div class="log-line"><span class="log-k">status</span> <span class="log-op">:</span> <span class="log-v">public</span></div>
              <div class="log-line"><span class="log-k">mode</span> <span class="log-op">:</span> <span class="log-v">writing</span></div>
              <div class="log-line"><span class="log-k">updated</span> <span class="log-op">:</span> <span class="log-v">{latestDate}</span></div>
              <div class="log-line"><span class="log-k">index</span> <span class="log-op">:</span> <span class="log-v">latest</span></div>
            </div>
          </aside>

          <div class="posts3d" data-posts3d>
            <canvas class="posts3d__canvas" data-posts3d-canvas></canvas>
            <button class="posts3d__nav posts3d__nav--prev" data-posts3d-prev aria-label="上一篇">←</button>
            <button class="posts3d__nav posts3d__nav--next" data-posts3d-next aria-label="下一篇">→</button>
            <div class="posts3d__info">
              <a class="posts3d__info-title" data-posts3d-link href="/blog">—</a>
              <p class="posts3d__info-meta" data-posts3d-meta></p>
            </div>
            <script type="application/json" is:inline data-posts3d-data set:html={JSON.stringify(posts3dData)}></script>
          </div>

          <!-- Right: TOPICS -->
          <aside class="side-card side-card--topics">
            <div class="side-card__head">TOPICS</div>
            <div class="side-card__body">
              {topTags.map((tag) => <a class="topic-tag" href={`/tags/${tag}/`}>{tag}</a>)}
            </div>
          </aside>
        </div>

        <div class="blog-section__inner">
          <div class="blog-section__list" data-reveal>
            {listPosts.map((post) => (
              <a href={`/blog/${post.id}/`} class="bp-row">
                <div class="bp-row__meta">
                  <span class="bp-row__date">
                    {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </span>
                  {post.data.tags && post.data.tags.length > 0 && (
                    <span class="bp-row__tags">
                      {post.data.tags.map(tag => <span class="bp-row__tag">#{tag}</span>)}
                    </span>
                  )}
                </div>
                <h3 class="bp-row__title">{post.data.title}</h3>
                <p class="bp-row__desc">{post.data.description}</p>
              </a>
            ))}
          </div>
          <a href="/blog" class="blog-section__all" data-reveal>查看全部文章 <span class="arr">→</span></a>
        </div>
      </section>

      <!-- ═══════════ BUILD（终端动画）═══════════ -->
      <section class="build" id="build">
        <div class="build__left" data-reveal>
          <span class="build__kicker">BUILD</span>
          <h2 class="build__title">Build</h2>
          <p class="build__sub"><span class="dot"></span>公开建造中</p>
          <p class="build__desc">不是等到完美才发布，<br>而是在构建过程中持续记录。</p>
          <p class="build__desc build__desc--sub">这里存放我的技术实验、工具笔记、项目复盘和一些正在形成的想法。</p>
          <ul class="build__projects">
            {buildProjects.map((proj) => (
              <li class="build-proj">
                <a href={proj.url} class="build-proj__link">
                  <span class={`build-proj__status build-proj__status--${proj.status}`}>{proj.status}</span>
                  <span class="build-proj__title">{proj.title}</span>
                  <span class="build-proj__arr">→</span>
                </a>
              </li>
            ))}
          </ul>

          <div class="build__cta">
            <a href="/blog" class="btn btn--ghost">进入博客 <span class="arr">→</span></a>
            <a href="/tags/" class="btn btn--link">查看实验 <span class="arr">→</span></a>
          </div>
        </div>

        <div class="build__stats" data-reveal>
          {buildStats.map(s => (
            <div class="stat-card">
              <span class="stat-card__value">{s.value}</span>
              <span class="stat-card__label">{s.label}</span>
            </div>
          ))}
          <div class="stat-card stat-card--stack">
            <span class="stat-card__label stat-card__label--stack">Stack</span>
            <div class="stack-tags">
              {techStack.map(t => <span class="stack-tag">{t}</span>)}
            </div>
          </div>
        </div>

        <!-- Retro monitor: cartoon hands type, screen boots the blog. Click → /blog. -->
        <div class="build__scene" data-buildscene>
          <canvas data-buildscene-canvas aria-label="打开博客 / Open the blog"></canvas>
        </div>
      </section>

      <!-- ═══════════ CONTACT ═══════════ -->
      <section class="contact" id="contact">
        <div class="contact__center">
          <div class="contact__kicker" data-reveal><span class="ln"></span>GET IN TOUCH / 联系<span class="ln"></span></div>
          <h2 class="contact__title" data-reveal>
            Let&rsquo;s talk.
            <svg class="contact__underline" viewBox="0 0 360 18" preserveAspectRatio="none" aria-hidden="true">
              <path d="M12 13 Q 180 3, 348 11" fill="none" stroke="#F0652E" stroke-width="3" stroke-linecap="round"/>
            </svg>
          </h2>
          <p class="contact__sub" data-reveal>有任何想法，欢迎联系</p>
          <p class="contact__status" data-reveal><span class="pulse"></span>开放交流 · Available</p>
        </div>

        <div class="contact__marquee" aria-hidden="true">
          <div class="marquee__track">
            <span class="marquee__set">AI 实践 · 媒体 · build in public · 搞钱 · AI 实践 · 媒体 · build in public · 搞钱 · AI 实践 · 媒体 · build in public · 搞钱 · </span>
            <span class="marquee__set">AI 实践 · 媒体 · build in public · 搞钱 · AI 实践 · 媒体 · build in public · 搞钱 · AI 实践 · 媒体 · build in public · 搞钱 · </span>
          </div>
        </div>

        <div class="contact__bar">
          <a class="cbar__item" href="https://x.com/memeboi94510412" target="_blank" rel="noopener">
            <span class="cbar__logo"><svg viewBox="0 0 24 24"><path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></span>
            <span class="cbar__val">X / Twitter <em>· DM</em></span>
            <span class="cbar__arr">→</span>
          </a>
          <a class="cbar__item" href="https://github.com/Plsbringmeadream" target="_blank" rel="noopener">
            <span class="cbar__logo"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/></svg></span>
            <span class="cbar__val">GitHub</span>
            <span class="cbar__arr">→</span>
          </a>
          <a class="cbar__item" href="/rss.xml">
            <span class="cbar__logo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg></span>
            <span class="cbar__val">RSS 订阅</span>
            <span class="cbar__arr">→</span>
          </a>
        </div>
      </section>
    </main>

    <Footer />

    <!-- GSAP -->
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

    <!-- Sac JS 交互 -->
    <script is:inline src="/js/particles.js?v=particle-avatar-8"></script>
    <script is:inline src="/js/main.js"></script>
    <script is:inline src="/js/pacman.js"></script>
    <script type="module" is:inline src="/js/posts3d.js"></script>
    <script type="module" is:inline src="/js/buildscene.js"></script>
  </body>
</html>

<style>
  /* ═══════════ HERO ═══════════ */
  .hero {
    position: relative;
    min-height: 100vh;
    padding: 0 var(--pad-x) 0 calc(var(--rail-x) + 56px);
    display: grid;
    grid-template-columns: minmax(0,38%) minmax(0,62%);
    align-items: stretch;
    gap: 0;
    overflow: hidden;
  }

  /* ── Hero mascots: standing pixel characters in the lower band ── */
  .hero__mascots {
    position: absolute;
    left: 0; right: 0;
    bottom: clamp(16px, 4vh, 56px);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding: 0 clamp(24px, 5vw, 80px);
    pointer-events: none;
    z-index: 2;
  }
  .hero__mascot {
    height: clamp(150px, 26vh, 320px);
    width: auto;
    border-radius: 0;
    image-rendering: pixelated;
    filter: drop-shadow(0 12px 18px rgba(26,23,20,.18));
  }
  /* Keyboard: transparent PNG (white background removed), a flat icon that
     floats centered between the two characters. */
  .hero__mascot--kbd {
    height: clamp(120px, 20vh, 240px);
    align-self: center;
    image-rendering: auto;
    filter: drop-shadow(0 10px 16px rgba(26,23,20,.16));
  }
  /* Laptop screens are short: the bottom mascots crowd the CTA there.
     Only show them when the hero is tall enough to have spare room. */
  @media (max-height: 900px) {
    .hero__mascots { display: none; }
  }

  /* ── Pac-Man that chases the cursor across the hero (driven by pacman.js) ── */
  .pac-orbit {
    position: absolute; inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 6;
    opacity: 0;
    transition: opacity .45s ease;
  }
  .pac-orbit.is-ready { opacity: 1; }
  .pac-sprite {
    position: absolute; top: 0; left: 0;
    will-change: transform;
  }
  .pac-man { width: 30px; height: 30px; }
  .pac-man svg { display: block; width: 100%; height: 100%; fill: #ffd200;
    filter: drop-shadow(0 2px 2px rgba(26,23,20,.2)); }
  .pac-man path { animation: pac-chomp .34s ease-in-out infinite; }
  .pac-ghost { width: 28px; height: 30px; }
  .pac-ghost svg { display: block; width: 100%; height: 100%;
    filter: drop-shadow(0 2px 2px rgba(26,23,20,.2)); }
  .pac-ghost .gbody { fill: currentColor; }
  .pac-ghost--1 { color: #ff5c5c; }
  .pac-ghost--2 { color: #39c5e0; }
  .pac-ghost--3 { color: #ffa23e; }
  .pac-pellet {
    position: absolute; width: 8px; height: 8px;
    border-radius: 50%; background: var(--muted);
    transform: translate(-50%, -50%);
    transition: opacity .16s ease, transform .16s ease;
  }
  .pac-pellet.eaten { opacity: 0; transform: translate(-50%, -50%) scale(.2); }
  @keyframes pac-chomp {
    0%   { d: path("M0,0 L15.96,-1.12 A16,16 0 1 1 15.96,1.12 Z"); }
    50%  { d: path("M0,0 L13.1,-9.2 A16,16 0 1 1 13.1,9.2 Z"); }
    100% { d: path("M0,0 L15.96,-1.12 A16,16 0 1 1 15.96,1.12 Z"); }
  }
  @media (prefers-reduced-motion: reduce) { .pac-orbit { display: none; } }
  .hero__left {
    display: flex; flex-direction: column; justify-content: flex-start;
    padding: calc(var(--nav-h) + 7vh) 0 6vh;
    max-width: 760px;
    position: relative; z-index: 4;
  }
  .hero__lower {
    margin-top: clamp(34px, 4.8vh, 66px);
    margin-left: clamp(8px, 1.2vw, 22px);
  }
  .hero__wordmark {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(56px, 12vw, 220px);
    line-height: .9;
    letter-spacing: -.02em;
  }
  .hero__kicker {
    display: flex; align-items: center; gap: 11px;
    font-size: clamp(16px, 1.12vw, 20px); letter-spacing: .05em; color: var(--accent);
    margin-bottom: 28px;
  }
  .hero__kicker .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--accent); flex: none; }
  .hero__slogan {
    font-family: var(--sans-cjk); font-weight: 300;
    font-size: clamp(23px, 2vw, 34px); line-height: 1.6;
    color: var(--ink); margin-bottom: 32px;
  }
  .hero__cta { display: flex; align-items: stretch; gap: 24px; width: min(100%, 390px); flex-wrap: nowrap; }
  .hero__cta .btn { flex: 1 1 0; height: 58px; padding: 0 22px; justify-content: center; }

  .hero__right { display: flex; justify-content: flex-start; align-items: flex-start; }
  .portrait {
    position: relative; flex: none;
    width: min(68vw, 1240px);
    aspect-ratio: 945/638;
    margin-top: calc(var(--nav-h) + 24px);
    margin-left: clamp(6px, 1vw, 22px);
  }
  .portrait__media { position: absolute; inset: 0; overflow: hidden; z-index: 1; }
  .portrait__img {
    position: absolute; top: 0; left: 0;
    width: 100%; height: 100%; max-width: none; object-fit: cover;
    mix-blend-mode: multiply;
    transform-origin: 50% 46%;
    opacity: 0;
    transition: opacity .35s var(--ease), filter .35s var(--ease);
  }
  .portrait__cross {
    position: absolute; z-index: 5; display: block;
    width: 58px; height: 58px; pointer-events: none;
    --corner-overhang: 6px;
  }
  .portrait__cross::before, .portrait__cross::after {
    content: ""; position: absolute;
