---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
// unique tags for filter bar
const allTags = [...new Set(posts.flatMap(p => p.data.tags ?? []))].sort();
---

<!doctype html>
<html lang="zh">
  <head>
    <BaseHead title={`Blog — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
    <style>
      main { width: 960px; max-width: calc(100% - 2rem); margin: 0 auto; padding: calc(var(--nav-h) + 1.5rem) 1rem 3rem; }
      .blog-header { padding: 1rem 0 1.5rem; }
      .blog-header h1 { font-family: var(--serif); font-weight: 500; font-size: clamp(48px, 5vw, 72px); margin-bottom: 0.5rem; }
      .blog-header p { color: var(--muted); font-size: 1rem; }
      ul { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; list-style: none; margin: 0; padding: 0; }
      ul li { display: flex; flex-direction: column; }
      ul li a { display: flex; flex-direction: column; height: 100%; text-decoration: none; color: inherit; transition: 0.2s ease; }
      ul li .img-wrapper { width: 100%; aspect-ratio: 2 / 1; overflow: hidden; border-radius: 12px; margin-bottom: 0.75rem; background: var(--line); }
      ul li .img-wrapper img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .title { margin: 0 0 0.25rem 0; line-height: 1.3; font-size: 1.1rem; font-weight: 600; color: var(--ink); transition: color 0.2s ease; }
      .date { margin: 0; color: var(--muted); font-size: 0.85rem; }
      ul li a:hover .title { color: var(--accent); }
      ul li a:hover .img-wrapper img { box-shadow: var(--box-shadow); transition: box-shadow 0.2s ease; }
      .post-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.3rem; }
      .post-tag { font-size: 0.75rem; padding: 0.15rem 0.5rem; border: var(--tag-border); border-radius: var(--tag-radius); color: var(--tag-fg); }
      .post-list-item { display: flex; flex-direction: column; }
      .post-list-item.hidden { display: none; }

      /* ── Filter bar ── */
      .filter-bar {
        display: flex; flex-wrap: wrap; gap: 0.5rem;
        padding: 0 0 1.5rem; border-bottom: 1px solid var(--line);
        margin-bottom: 2rem;
      }
      .filter-btn {
        padding: 0.35rem 0.9rem;
        border: var(--tag-border); border-radius: var(--tag-radius);
        background: transparent; color: var(--tag-fg);
        font-size: 0.82rem; cursor: pointer;
        transition: all 0.2s; font-family: inherit;
      }
      .filter-btn:hover { border-color: var(--tag-hover-border); color: var(--tag-hover-fg); }
      .filter-btn.active {
        border-color: var(--accent); color: var(--accent);
        background: var(--tag-hover-bg);
      }
      @media (max-width: 720px) {
        ul { grid-template-columns: 1fr; gap: 1rem; }
        main { padding: calc(var(--nav-h) + 1rem) 1rem 2rem; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="blog-header">
        <h1>Blog</h1>
        <p>共 <span id="post-count">{posts.length}</span> 篇文章</p>
      </div>

      <nav class="filter-bar" id="filter-bar" aria-label="筛选标签">
        <button class="filter-btn active" data-filter="all">全部</button>
        {allTags.map(tag => <button class="filter-btn" data-filter={tag}>{tag}</button>)}
      </nav>

      <ul id="post-list">
        {posts.map((post) => (
          <li data-tags={JSON.stringify(post.data.tags ?? [])}>
            <a href={`/blog/${post.id}/`}>
              <div class="img-wrapper">
                {post.data.heroImage && <Image width={720} height={360} src={post.data.heroImage} alt="" />}
              </div>
              <h4 class="title">{post.data.title}</h4>
              <p class="date"><FormattedDate date={post.data.pubDate} /></p>
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="post-tags">
                  {post.data.tags.map((tag) => <span class="post-tag">#{tag}</span>)}
                </div>
              )}
            </a>
          </li>
        ))}
      </ul>
    </main>
    <Footer />

    <script>
      function initFilter() {
        const bar = document.getElementById('filter-bar');
        if (!bar) return;
        const btns = bar.querySelectorAll('.filter-btn');
        const items = document.querySelectorAll('#post-list li');
        const counter = document.getElementById('post-count');

        btns.forEach(btn => {
          btn.addEventListener('click', () => {
            btns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            const tag = btn.dataset.filter;
            let visible = 0;
            items.forEach(li => {
              if (tag === 'all') {
                li.classList.remove('hidden'); visible++;
              } else {
                const tags = JSON.parse(li.dataset.tags || '[]');
                if (tags.includes(tag)) { li.classList.remove('hidden'); visible++; }
                else { li.classList.add('hidden'); }
              }
            });
            if (counter) counter.textContent = String(visible);
          });
        });
      }
      document.addEventListener('astro:page-load', initFilter);
      initFilter();
    </script>
  </body>
</html>
