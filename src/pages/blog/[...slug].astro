---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);

// Reading time: bilingual content, ~300 chars/min for Chinese, ~200 words/min English
const readingTime = Math.max(1, Math.round((post.body?.length ?? 0) / 400));

// Related posts: same tags, exclude current, top 3 by tag overlap
const allPosts = (await getCollection('blog')).filter(p => p.id !== post.id);
const currentTags = new Set(post.data.tags ?? []);
const relatedPosts = allPosts
  .map(p => ({ post: p, overlap: (p.data.tags ?? []).filter(t => currentTags.has(t)).length }))
  .filter(r => r.overlap > 0)
  .sort((a, b) => b.overlap - a.overlap || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
  .slice(0, 3)
  .map(r => ({ title: r.post.data.title, url: `/blog/${r.post.id}/`, date: r.post.data.pubDate }));
---

<BlogPost {...post.data} readingTime={readingTime} relatedPosts={relatedPosts}>
	<Content />
</BlogPost>
