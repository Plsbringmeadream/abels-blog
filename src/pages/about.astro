---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh">
  <head>
    <BaseHead title={`About — ${SITE_TITLE}`} description="About Abel - AI enthusiast, mechanical keyboard lover, and builder" />
    <style>
      .about-container { max-width: 1100px; margin: 0 auto; padding: calc(var(--nav-h) + 3rem) 1.5rem 4rem; }
      .profile { display: flex; gap: 2.5rem; align-items: flex-start; margin-bottom: 1rem; }
      .profile__avatar { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; flex-shrink: 0; }
      .profile__avatar img { width: 90px; height: 90px; border-radius: 50%; object-fit: cover; border: 2px solid var(--line); }
      .profile__status { display: flex; align-items: center; gap: 0.35rem; font-size: 0.78rem; color: var(--muted); font-family: var(--mono); letter-spacing: .04em; }
      .status-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--status-active); }
      .profile__bio { flex: 1; }
      .profile__name { font-family: var(--serif); font-size: 2.8rem; font-weight: 500; margin: 0 0 0.2rem; letter-spacing: -.02em; }
      .profile__handle { font-size: 0.9rem; color: var(--muted); margin-bottom: 0.8rem; font-family: var(--mono); }
      .profile__handle span { color: var(--line); margin: 0 0.3rem; }
      .profile__desc { font-size: 0.95rem; line-height: 1.7; color: var(--ink-soft); margin-bottom: 0.9rem; }
      .profile__meta { display: flex; gap: 1.2rem; flex-wrap: wrap; font-size: 0.82rem; color: var(--muted); }
      .profile__meta span { display: flex; align-items: center; gap: 0.3rem; }
      .profile__meta svg { width: 13px; height: 13px; opacity: 0.6; color: var(--accent); }
      .divider { border: none; border-top: 1px solid var(--line); margin: 2rem 0; }
      .about-dual { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; margin-bottom: 2rem; }
      .about-signal { display: flex; flex-direction: column; gap: 2rem; }
      .about-blueprint { position: relative; width: 100%; height: clamp(330px, 28vw, 400px); border: 1px solid var(--line); background: linear-gradient(rgba(201,192,178,.14) 1px, transparent 1px) 0 0 / 100% 31px, linear-gradient(90deg, rgba(201,192,178,.14) 1px, transparent 1px) 0 0 / 31px 100%; }
      .bp__img { position: absolute; bottom: 0; left: 50%; transform: translateX(-47%); width: 47%; height: auto; max-width: none; mix-blend-mode: multiply; filter: saturate(0) contrast(1.05); }
      :global(.dark) .bp__img { mix-blend-mode: screen; filter: saturate(0) contrast(1.2) brightness(0.6); opacity: 0.7; }
      .bp__ring { position: absolute; top: 50%; left: 53%; width: 44%; aspect-ratio: 1; transform: translate(-50%,-50%); border: 1px solid rgba(240,101,46,.16); border-radius: 50%; }
      .bp__target { position: absolute; width: 17px; height: 17px; border-radius: 50%; border: 1px solid var(--accent); }
      .bp__target::before, .bp__target::after { content: ""; position: absolute; background: var(--accent); }
      .bp__target::before { top: 50%; left: -5px; right: -5px; height: 1px; transform: translateY(-50%); }
      .bp__target::after { left: 50%; top: -5px; bottom: -5px; width: 1px; transform: translateX(-50%); }
      .bp__target--tl { top: 14px; left: 14px; }
      .bp__target--tr { top: 14px; right: 14px; }
      .bp__target--bl { bottom: 14px; left: 14px; }
      .bp__target--br { bottom: 14px; right: 14px; }
      .bp__plus { position: absolute; transform: translate(-50%,-50%); font-family: var(--mono); font-size: 12px; color: var(--line); pointer-events: none; }
      .bp__anno { position: absolute; }
      .bp__mono { font-family: var(--mono); font-size: 7.6px; line-height: 1.62; letter-spacing: .04em; color: var(--muted); white-space: nowrap; text-transform: uppercase; }
      .bp__mono--key { color: var(--ink-soft); font-weight: 600; }
      .bp__lead { display: flex; align-items: center; gap: 7px; font-family: var(--mono); font-size: 8.5px; font-weight: 600; letter-spacing: .06em; color: var(--ink); text-transform: uppercase; }
      .bp__sq { width: 5px; height: 5px; background: var(--accent); display: inline-block; }
      .bp__hr { display: block; width: 110px; height: 1px; background: var(--line); margin: 7px 0; }
      .bp__hatch { display: block; width: 42px; height: 12px; margin-top: 6px; background: repeating-linear-gradient(45deg, var(--line) 0 1px, transparent 1px 4px); }
      .bp__anno--tl { top: 28px; left: 34px; }
      .bp__anno--spec { top: 32%; left: 34px; }
      .bp__anno--ver { bottom: 58px; left: 34px; }
      .bp__anno--tr { top: 28px; right: 34px; text-align: right; }
      .bp__anno--cat { top: 32%; right: 34px; text-align: right; }
      .bp__anno--cat .bp__hatch { margin-left: auto; }
      .bp__anno--focus { top: 60%; right: 34px; text-align: right; }
      .bp__anno--est { bottom: 58px; right: 34px; text-align: right; }
      .bp__coords { position: absolute; left: 50%; bottom: 16px; transform: translateX(-50%); font-family: var(--mono); font-size: 8px; line-height: 1.55; letter-spacing: .12em; color: var(--ink-soft); white-space: nowrap; }
      .signal-title { font-family: var(--mono); font-size: 0.8rem; color: var(--muted); font-weight: 500; margin-bottom: 1rem; letter-spacing: .12em; text-transform: uppercase; }
      .tags-row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
      .tag { display: inline-flex; padding: 0.3rem 0.85rem; border-radius: 999px; font-size: 0.82rem; font-weight: 500; border: 1.5px solid; white-space: nowrap; font-family: var(--sans); }
      .tag-orange { color: var(--accent); border-color: rgba(240,101,46,.3); background: rgba(240,101,46,.06); }
      .tag-purple { color: var(--tag-purple); border-color: var(--tag-purple-border); background: var(--tag-purple-bg); }
      .tag-green { color: var(--tag-green); border-color: var(--tag-green-border); background: var(--tag-green-bg); }
      .tag-mono { color: var(--muted); border-color: var(--line); font-family: var(--mono); }
      .signal { max-width: 500px; }
      .signal__head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--ink); margin-bottom: 0; }
      .signal__title { font-family: var(--serif-cjk); font-weight: 600; font-size: clamp(20px, 2vw, 28px); line-height: 1; margin: 0; }
      .signal__legend { font-family: var(--mono); font-size: 11px; letter-spacing: .14em; color: var(--muted); }
      .signal__legend b { color: var(--accent); font-weight: 600; }
      .signal__list { list-style: none; margin: 0; padding: 0; }
      .srow { border-bottom: 1px solid var(--line); }
      .srow > a { display: grid; grid-template-columns: 42px minmax(86px,1fr) 76px 70px; justify-content: space-between; align-items: center; min-height: 60px; padding: 8px 0; transition: background .25s; text-decoration: none; color: var(--ink); }
      .srow > a:hover { background: rgba(240,101,46,.075); }
      .srow__logo { width: 36px; height: 36px; border-radius: 9px; display: flex; align-items: center; justify-content: center; }
      .srow__logo svg { width: 20px; height: 20px; display: block; }
      .srow__logo--x { background: var(--ink); color: #fff; }
      .srow__logo--gh { background: var(--ink); color: #fff; }
      :global(.dark) .srow__logo--x,
      :global(.dark) .srow__logo--gh { background: #e8e8e8; color: #111; }
      .srow__handle { font-family: var(--sans); font-size: clamp(13px, 1vw, 15px); color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .srow__bars { display: flex; align-items: flex-end; gap: 4px; height: 28px; justify-self: end; }
      .srow__bars i { width: 7px; border-radius: 2px; background: var(--accent); }
      .srow__bars i:nth-child(1) { height: 32%; }
      .srow__bars i:nth-child(2) { height: 44%; }
      .srow__bars i:nth-child(3) { height: 56%; }
      .srow__bars i:nth-child(4) { height: 68%; }
      .srow__bars i:nth-child(5) { height: 80%; }
      .srow__bars i:nth-child(6) { height: 90%; }
      .srow__bars i:nth-child(7) { height: 100%; }
      .srow__status { display: flex; align-items: center; gap: 6px; justify-self: end; font-family: var(--mono); font-size: 11px; letter-spacing: .08em; color: var(--ink); }
      .srow__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 0 rgba(240,101,46,.5); animation: srow-pulse 2s infinite; }
      @keyframes srow-pulse { 0% { box-shadow: 0 0 0 0 rgba(240,101,46,.45); } 70% { box-shadow: 0 0 0 6px rgba(240,101,46,0); } 100% { box-shadow: 0 0 0 0 rgba(240,101,46,0); } }
      .projects-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
      .project-card { background: rgba(255,255,255,.5); border: 1px solid var(--line); border-radius: 12px; padding: 1.1rem 1rem 0.9rem; text-decoration: none; color: inherit; display: flex; flex-direction: column; gap: 0.35rem; transition: box-shadow 0.2s var(--ease); cursor: pointer; }
      :global(.dark) .project-card { background: rgba(255,255,255,.04); border-color: #333; }
      .project-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,.06); border-color: var(--accent); }
      .project-icon { font-size: 1.4rem; margin-bottom: 0.2rem; }
      .project-name { font-size: 0.92rem; font-weight: 600; color: var(--ink); }
      .project-desc { font-size: 0.78rem; color: var(--muted); line-height: 1.45; flex: 1; }
      .project-badge { display: inline-block; padding: 0.15rem 0.6rem; border-radius: 999px; font-size: 0.72rem; font-weight: 500; margin-top: 0.4rem; align-self: flex-start; background: var(--paper); border: 1px solid var(--line); color: var(--muted); font-family: var(--mono); }
      .badge--active { border-color: var(--status-active); color: var(--status-active-text); background: var(--status-active-bg); }
      .badge--ongoing { border-color: var(--status-ongoing); color: var(--status-ongoing-text); background: var(--status-ongoing-bg); }
      .social-section { margin-top: 2rem; }
      .social-links { display: flex; gap: 0.75rem; flex-wrap: wrap; }
      .social-btn { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.45rem 1rem; border: 1.5px solid var(--line); border-radius: 8px; background: rgba(255,255,255,.5); font-size: 0.84rem; color: var(--ink-soft); text-decoration: none; font-weight: 500; transition: all 0.2s var(--ease); }
      :global(.dark) .social-btn { background: rgba(255,255,255,.04); }
      .social-btn:hover { border-color: var(--accent); color: var(--accent); }
      .social-btn svg { width: 14px; height: 14px; opacity: 0.7; }
      @media (max-width: 860px) { .about-dual { grid-template-columns: 1fr; gap: 32px; } .about-blueprint { height: auto; aspect-ratio: 1.34; } .bp__img { width: 55%; } }
      @media (max-width: 600px) { .profile { flex-direction: column; gap: 1rem; align-items: center; text-align: center; } .profile__meta { justify-content: center; } .profile__name { font-size: 2rem; } .projects-grid { grid-template-columns: 1fr; } .srow > a { grid-template-columns: 36px 1fr auto; } .srow__bars { display: none; } }
    </style>
  </head>
  <body>
    <Header />

    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <filter id="duotone" color-interpolation-filters="sRGB">
          <feColorMatrix type="matrix" values="0.33 0.33 0.33 0 0 0.33 0.33 0.33 0 0 0.33 0.33 0.33 0 0 0 0 0 1 0"/>
          <feComponentTransfer color-interpolation-filters="sRGB">
            <feFuncR type="table" tableValues="0.102 0.941"/>
            <feFuncG type="table" tableValues="0.090 0.396"/>
            <feFuncB type="table" tableValues="0.078 0.180"/>
          </feComponentTransfer>
        </filter>
      </defs>
    </svg>

    <main>
      <div class="about-container">

        <!-- Profile Header -->
        <div class="profile" data-reveal>
          <div class="profile__avatar">
            <img src="/anime-avatar.jpg" alt="Avatar" />
            <div class="profile__status">
              <span class="status-dot"></span>
              building
            </div>
          </div>
          <div class="profile__bio">
            <h1 class="profile__name">Abel</h1>
            <div class="profile__handle">@abelchen <span>&bull;</span> chen</div>
            <p class="profile__desc">
              折腾 AI 工具 / 键帽爱好者 / 自动化探索者。<br />
              把想法变成能跑的东西。
            </p>
            <div class="profile__meta">
              <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg> China</span>
              <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v16H4z" rx="2"/><path d="M16 2v4M8 2v4M4 10h16"/></svg> ZH / EN</span>
              <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/><path d="M2 12h20"/></svg> Astro &middot; Vercel</span>
            </div>
          </div>
        </div>

        <hr class="divider" />

        <!-- Blueprint + Signal -->
        <div class="about-dual">
          <div class="about-blueprint" data-reveal>
            <span class="bp__target bp__target--tl"></span>
            <span class="bp__target bp__target--tr"></span>
            <span class="bp__target bp__target--bl"></span>
            <span class="bp__target bp__target--br"></span>
            <span class="bp__plus" style="top:30%;left:25%">+</span>
            <span class="bp__plus" style="top:70%;left:30%">+</span>
            <span class="bp__plus" style="top:34%;left:62%">+</span>
            <span class="bp__plus" style="top:60%;left:58%">+</span>
            <span class="bp__ring" aria-hidden="true"></span>
            <img class="bp__img" src="/assets/about-portrait-sketch.png" alt="Abel 线稿头像" />
            <div class="bp__anno bp__anno--tl">
              <p class="bp__lead"><i class="bp__sq"></i> AI ENTHUSIAST / BUILDER</p>
              <span class="bp__hr"></span>
              <p class="bp__mono">AUTOMATION &middot; KEYBOARDS &middot; CONTENT</p>
            </div>
            <div class="bp__anno bp__anno--spec">
              <p class="bp__mono bp__mono--key">SPEC.001</p>
              <p class="bp__mono">FOCUS  : AI AUTOMATION</p>
              <p class="bp__mono">TOPIC  : TOOLS &amp; WORKFLOW</p>
              <p class="bp__mono">FORMAT : BLOG / BUILD</p>
              <p class="bp__mono">STACK  : ASTRO &middot; VERCEL</p>
            </div>
            <div class="bp__anno bp__anno--ver">
              <p class="bp__mono bp__mono--key">VER. 1.0.0</p>
              <p class="bp__mono">DATE. 2026</p>
            </div>
            <div class="bp__anno bp__anno--tr">
              <p class="bp__mono bp__mono--key">ID // ABEL</p>
            </div>
            <div class="bp__anno bp__anno--cat">
              <p class="bp__mono">CATEGORY</p>
              <p class="bp__mono">IN PUBLIC</p>
              <span class="bp__hatch" aria-hidden="true"></span>
            </div>
            <div class="bp__anno bp__anno--focus">
              <p class="bp__mono bp__mono--key">FOCUS</p>
              <p class="bp__mono">&middot; AUTOMATION</p>
              <p class="bp__mono">&middot; KEYBOARDS</p>
              <p class="bp__mono">&middot; AI</p>
            </div>
            <div class="bp__anno bp__anno--est">
              <p class="bp__mono">EST. 2026</p>
            </div>
            <figcaption class="bp__coords">N 31&deg; 24&prime; 37.56&Prime;&nbsp;&nbsp;&nbsp;&nbsp;E 121&deg; 35&prime; 09.81&Prime;</figcaption>
          </div>

          <!-- Right: Tags + Signal -->
          <div class="about-signal">
            <div class="signal-tags" data-reveal>
              <h3 class="signal-title">关注领域</h3>
              <div class="tags-row">
                <span class="tag tag-orange">AI Automation</span>
                <span class="tag tag-orange">Claude API</span>
                <span class="tag tag-orange">n8n</span>
                <span class="tag tag-orange">LLM Tools</span>
                <span class="tag tag-purple">Mechanical Keyboards</span>
                <span class="tag tag-purple">Keycaps</span>
                <span class="tag tag-green">GMK &middot; PBT &middot; ABS</span>
                <span class="tag tag-green">Business Writing</span>
                <span class="tag tag-mono">Windows Sysadmin</span>
                <span class="tag tag-mono">Obsidian PKM</span>
                <span class="tag tag-mono">Astro</span>
              </div>
            </div>

            <div class="signal" data-reveal>
              <div class="signal__head">
                <h3 class="signal__title">全平台信号台</h3>
                <span class="signal__legend"><b>LIVE</b> / SOON</span>
              </div>
              <ul class="signal__list">
                <li class="srow srow--live">
                  <a href="https://x.com/memeboi94510412" target="_blank" rel="noopener">
                    <span class="srow__logo srow__logo--x">
                      <svg viewBox="0 0 24 24"><path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                    </span>
                    <span class="srow__handle">@memeboi94510412</span>
                    <span class="srow__bars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
                    <span class="srow__status"><i class="srow__dot"></i> LIVE</span>
                  </a>
                </li>
                <li class="srow srow--live">
                  <a href="https://github.com/Plsbringmeadream" target="_blank" rel="noopener">
                    <span class="srow__logo srow__logo--gh">
                      <svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.92.58.1.79-.25.79-.56v-2.15c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.16 1.18.92-.26 1.9-.38 2.88-.39.98 0 1.96.13 2.88.39 2.2-1.49 3.16-1.18 3.16-1.18.62 1.58.23 2.75.11 3.04.74.8 1.18 1.83 1.18 3.08 0 4.42-2.69 5.38-5.25 5.67.42.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
                    </span>
                    <span class="srow__handle">Plsbringmeadream</span>
                    <span class="srow__bars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
                    <span class="srow__status"><i class="srow__dot"></i> LIVE</span>
                  </a>
                </li>
              </ul>
            </div>

            <!-- Projects -->
            <div class="projects-section" data-reveal>
              <h3 class="signal-title">正在做的事</h3>
              <div class="projects-grid">
                <a href="/blog/second-post" class="project-card">
                  <div class="project-icon">🤖</div>
                  <div class="project-name">AI Twitter Bot</div>
                  <div class="project-desc">n8n + Claude API + X API，每日自动推送双语 AI 行业资讯</div>
                  <span class="project-badge">In Progress</span>
                </a>
                <a href="/blog/first-post" class="project-card">
                  <div class="project-icon">🦀</div>
                  <div class="project-name">Abel's Blog</div>
                  <div class="project-desc">Astro + Vercel，记录 AI 工具折腾和键盘爱好者的个人空间</div>
                  <span class="project-badge badge--active">Active</span>
                </a>
                <a href="/blog/using-mdx" class="project-card">
                  <div class="project-icon">⚙️</div>
                  <div class="project-name">OpenClaw 配置</div>
                  <div class="project-desc">自托管 AI Gateway，探索多渠道 AI 自动化工作流</div>
                  <span class="project-badge badge--ongoing">Ongoing</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Social -->
        <div class="social-section" data-reveal>
          <h3 class="signal-title">联系方式</h3>
